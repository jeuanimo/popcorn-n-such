# =============================================================================
# Popcorn N Such — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# [REQUIRED] = must be set before the server will start in production.
# All others have defaults or are optional features.
# =============================================================================


# -----------------------------------------------------------------------------
# Django core  [REQUIRED in production]
# -----------------------------------------------------------------------------

# Long random string — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

# Settings module
DJANGO_SETTINGS_MODULE=config.settings.dev

# Comma-separated allowed hostnames
# Example: DJANGO_ALLOWED_HOSTS=popcornnsuch.com,www.popcornnsuch.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full origins for CSRF (include scheme)
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=https://popcornnsuch.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to false in production (prod settings enforce False regardless)
DJANGO_DEBUG=true

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DJANGO_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Database  [REQUIRED in production]
# -----------------------------------------------------------------------------

# PostgreSQL URL — format: postgres://user:password@host:port/dbname
# Omit in dev to fall back to SQLite.
DATABASE_URL=postgres://popcorn:popcorn@localhost:5432/popcorn_n_such

# Enable SSL for the database connection (Render, Railway, Supabase, etc.)
DB_SSL_REQUIRE=false


# -----------------------------------------------------------------------------
# Cache — Redis  (optional in dev, recommended in production)
# -----------------------------------------------------------------------------

# If set, Django uses Redis for caching and session storage.
# Format: redis://:password@host:port/db
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Media files — Cloudinary
# Get credentials from https://cloudinary.com/console → Dashboard
# Paste the full "API Environment variable" string as-is.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# -----------------------------------------------------------------------------

CLOUDINARY_URL=


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@popcornnsuch.com

# Email address that receives Django 500-error notifications (optional)
DJANGO_ADMIN_EMAIL=


# -----------------------------------------------------------------------------
# Error tracking — Sentry (optional, strongly recommended in production)
# -----------------------------------------------------------------------------

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
GIT_COMMIT_SHA=


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Full public URL of the site — used in emails and absolute links
SITE_BASE_URL=https://popcornnsuch.com


# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------

# Active gateway: godaddy | stripe | paypal
PAYMENTS_PROVIDER=godaddy
PAYMENTS_WEBHOOK_SECRET=
GODADDY_PAYMENTS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# GoDaddy Payments (Poynt Commerce Platform)
# -----------------------------------------------------------------------------
# Environment selects the API host:
#   ote  -> https://services-ote.poynt.net  (staging / OTE — use for ALL testing)
#   prod -> https://services.poynt.net      (LIVE MONEY)
# Leave this on "st" until you have completed the Phase 14 test checklist.
GODADDY_POYNT_ENV=ote
# Optional explicit override; leave blank to derive the host from the env above.
GODADDY_POYNT_API_HOST=

# From the Poynt HQ portal -> Business Settings / Developer.
GODADDY_POYNT_APPLICATION_ID=
GODADDY_POYNT_BUSINESS_ID=
GODADDY_POYNT_STORE_ID=

# RSA private key issued with your application. Provide EITHER of these.
#  - Inline: paste the PEM with real newlines written as the two characters \n
#  - Path:   absolute path to a .pem file stored OUTSIDE the repository
# NEVER commit the key itself, and never expose it to templates or JavaScript.
GODADDY_POYNT_PRIVATE_KEY=
GODADDY_POYNT_PRIVATE_KEY_PATH=

# API behaviour (safe defaults; override only if GoDaddy support tells you to).
GODADDY_POYNT_API_VERSION=1.2
GODADDY_POYNT_TIMEOUT_SECONDS=20
GODADDY_POYNT_TOKEN_LEEWAY_SECONDS=300
# SALE = authorize + capture together (normal checkout). AUTHORIZE = auth only.
GODADDY_PAYMENTS_CHARGE_ACTION=SALE

# --- Poynt Collect (browser card form) ---------------------------------------
GODADDY_COLLECT_ENABLED=true
# Leave blank to follow GODADDY_POYNT_ENV automatically (OTE vs production).
GODADDY_COLLECT_SDK_URL=
# Default to the Poynt IDs above; set only if Collect uses different values.
GODADDY_COLLECT_BUSINESS_ID=
GODADDY_COLLECT_APPLICATION_ID=
# Optional combined "businessId=applicationId" form shown in some GoDaddy docs.
GODADDY_COLLECT_APPLICATION_KEY=
GODADDY_COLLECT_IFRAME_HEIGHT=460px
GODADDY_COLLECT_RECAPTCHA_TYPE=DEFAULT
GODADDY_COLLECT_RECAPTCHA_TEXT_FONT_SIZE=14px
GODADDY_COLLECT_RECAPTCHA_TEXT_COLOR=#111827
GODADDY_COLLECT_RECAPTCHA_LINK_COLOR=#0d6efd
GODADDY_COLLECT_RECAPTCHA_LINK_TEXT_DECORATION=underline

# --- Legacy hosted-redirect fallback (only if not using Poynt Collect) --------
GODADDY_API_KEY=
GODADDY_MERCHANT_ID=
GODADDY_PAYMENTS_BASE_URL=
GODADDY_PAYMENTS_ALLOWED_REDIRECT_HOSTS=

# Development-only: lets checkout create orders with a fake payment reference.
# MUST be false/absent in production.
ALLOW_STUB_CHECKOUT_PAYMENT=false

# Stripe (if switching to Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (if switching to PayPal)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=production


# -----------------------------------------------------------------------------
# Shipping carriers
# -----------------------------------------------------------------------------

# Active provider: shippo | easypost | usps | pitney_bowes
SHIPPING_PROVIDER=shippo

SHIPPO_API_KEY=
EASYPOST_API_KEY=

# USPS (modern OAuth2 API — not legacy Web Tools)
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_ENV=production

# Pitney Bowes
PITNEY_BOWES_API_KEY=
PITNEY_BOWES_API_SECRET=
PITNEY_BOWES_ENV=production

# Ship-from address (used by admin fulfillment actions)
SHIPPING_FROM_NAME=Popcorn N Such
SHIPPING_FROM_ADDRESS_LINE_1=
SHIPPING_FROM_CITY=
SHIPPING_FROM_STATE=
SHIPPING_FROM_POSTAL_CODE=
SHIPPING_FROM_COUNTRY=US
SHIPPING_DEFAULT_WEIGHT_OZ=16


# -----------------------------------------------------------------------------
# Tax
# -----------------------------------------------------------------------------

# Active provider: manual | taxjar | avalara
TAX_PROVIDER=manual
TAX_FALLBACK_PROVIDER=manual

TAXJAR_API_KEY=
AVALARA_ACCOUNT_ID=
AVALARA_LICENSE_KEY=


# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# -----------------------------------------------------------------------------
# Security / auth
# -----------------------------------------------------------------------------

LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_WINDOW_SECONDS=900
REQUIRE_EMAIL_VERIFICATION=false
MFA_REQUIRED_ROLES=staff,admin
ALLOWED_REMOTE_IMAGE_HOSTS=


# -----------------------------------------------------------------------------
# Business rules
# -----------------------------------------------------------------------------

LARGE_ORDER_THRESHOLD_CENTS=15000
PURCHASE_ORDER_ALLOW_OVER_RECEIVE=false
ABANDONED_CART_ABANDONMENT_MINUTES=60
ABANDONED_CART_EVENT_EXPIRY_HOURS=168
ABANDONED_CART_TOKEN_EXPIRY_HOURS=96
